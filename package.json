{
  "name": "painel-clima",
  "version": "1.0.0",
  "private": true,
  "description": "Painel de clima com React, Vite e Open-Meteo: previsão atual, próximas 24 horas, 7 dias e favoritos",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "test:e2e:security": "playwright test",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text"
  },
  "keywords": [
    "react",
    "vite",
    "clima",
    "open-meteo",
    "previsao"
  ],
  "author": "Leonardo Fernandes Carrilho",
  "license": "MIT",
  "dependencies": {
    "@sentry/browser": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "c8": "^12.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
